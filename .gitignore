# If you prefer the allow list template instead of the deny list, see community template:
# https://github.com/github/gitignore/blob/main/community/Golang/Go.AllowList.gitignore
#
# Binaries for programs and plugins
/nexus
*.exe
*.exe~
*.dll
*.so
*.dylib

# Test binary, built with `go test -c`
*.test

# Output of the go coverage tool, specifically when used with LiteIDE
*.out

# Dependency directories (remove the comment below to include it)
# vendor/

# Go workspace file
go.work
go.work.sum

# env file
.env

extension-items-ibmi-main
.codegraph/
.atl/

# Local SSH transport harness secrets and generated Compose state.
/internal/remote/testdata/ssh/.env
/internal/remote/testdata/ssh/.env.*
/internal/remote/testdata/ssh/*.secret
/internal/remote/testdata/ssh/*.key
/internal/remote/testdata/ssh/*.pub
/internal/remote/testdata/ssh/compose.override.yaml
/internal/remote/testdata/ssh/state/
